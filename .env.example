# Copiez ce fichier en .env et reportez les mêmes valeurs dans Vercel → Settings → Environment Variables.

# URL publique de l'application, utilisée pour les invitations et la récupération de mot de passe.
APP_URL="http://localhost:3000"

# --- Supabase : un seul projet pour le navigateur et le serveur ---
SUPABASE_PROJECT_ID="VOTRE-REF-PROJET"
SUPABASE_URL="https://VOTRE-REF-PROJET.supabase.co"

# Clé publique : utilisable côté navigateur. Elle doit appartenir au même projet que SUPABASE_URL.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"
VITE_SUPABASE_PROJECT_ID="VOTRE-REF-PROJET"
VITE_SUPABASE_URL="https://VOTRE-REF-PROJET.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"

# SECRET — jamais préfixé par VITE_ et jamais commité.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxx"

# SECRET — protège les tâches cron Vercel. Ne jamais commiter la valeur réelle.
CRON_SECRET="changez-moi"
